# Copy this file to .env (do not commit secrets) and/or export as environment variables.

# BrowserStack credentials
BROWSERSTACK_USERNAME=your-username
BROWSERSTACK_ACCESS_KEY=your-access-key
BROWSERSTACK_BUILD_NAME=vansah-browserstack-build
BROWSERSTACK_PROJECT_NAME=Vansah BrowserStack
BROWSERSTACK_SESSION_NAME=Vansah + BrowserStack JUnit5 example

# Vansah connection
VANSAH_URL=https://prod.vansahnode.app
VANSAH_TOKEN=your-vansah-connect-token
VANSAH_ENVIRONMENT=QA

# Choose ONE of the below ways to reference the test case to execute in Vansah
# 1) Jira issue based
VANSAH_JIRA_ISSUE_KEY=KAN-123   # Example Jira issue
VANSAH_TESTCASE_KEY=KAN-C17     # Example Vansah Test Case key

# 2) Folder based (instead of Jira issue)
# VANSAH_FOLDER_PATH=vansah test automation/regression 2025/
# VANSAH_TESTCASE_KEY=KAN-C17

# 3) Standard Test Plan (STP)
# VANSAH_STP_KEY=KAN-P18
# VANSAH_TESTCASE_KEY=KAN-C17

# 4) Advanced Test Plan (ATP)
# VANSAH_ATP_KEY=KAN-P17
# VANSAH_ATP_ASSET_TYPE=folder  # or 'issue'
# VANSAH_TESTCASE_KEY=KAN-C17